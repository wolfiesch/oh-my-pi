{
  "name": "@oh-my-pi/appserver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared OMP authority bridge protocol and T4 host adapter",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src", "README.md"],
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./*": { "types": "./src/*.ts", "import": "./src/*.ts" }
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.json --noEmit",
    "check": "bun run build",
    "test": "bun test test/*.test.ts"
  },
  "dependencies": {
    "@t4-code/host-service": "0.1.31",
    "@t4-code/host-wire": "0.1.31"
  },
  "engines": { "bun": ">=1.3.14" }
}
